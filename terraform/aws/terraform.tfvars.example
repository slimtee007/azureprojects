# Copy to terraform.tfvars (never commit terraform.tfvars) and edit:
#   cp terraform.tfvars.example terraform.tfvars

aws_region    = "eu-west-1"
name_prefix   = "azuredrop-demo"
instance_type = "t3.small"

# Name of an EC2 key pair that already exists in the account/region.
key_name = "azuredrop-demo-key"

# Your admin IP + /32 (check https://ifconfig.me if unsure).
admin_cidr = "203.0.113.4/32"

root_volume_gb = 30

tags = {
  project = "azuredrop"
  role    = "live-demo-host"
}
