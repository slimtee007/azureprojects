# ---------------------------------------------------------------------------
# AzureDrop local environment. Copy to .env and edit. NEVER commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Backend -----------------------------------------------------------------
PORT=5001

# PostgreSQL. When the API runs on your host against docker compose,
# use localhost; the docker-compose.yml overrides this to the `postgres`
# host name for containers. Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://azuredrop:azuredrop-local-dev@localhost:5432/azuredrop

# Long, random string used to sign JWTs. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-for-local-dev-only

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Public base URL of the app itself (used when building share links).
PUBLIC_BASE_URL=http://localhost:5173

# --- Azure Blob storage (Azurite emulator locally / on the AWS demo host) ----
# Default Azurite development account connection string.
# The API connects to Azurite over the Docker network or localhost.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Browser-reachable base for short-lived signed download URLs.
# Locally: Azurite's published port on your workstation.
# On the AWS demo host set this to https://your-domain.example/devstoreaccount1
# (Nginx proxies that path to Azurite so port 10000 stays private).
AZURE_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:10000/devstoreaccount1

# Blob container that stores file objects.
AZURE_STORAGE_CONTAINER=azuredrop

# --- Upload / share limits ---------------------------------------------------
# Maximum upload size in bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400
# How long share links stay valid (default 60 minutes).
SHARE_TTL_MINUTES=60
# How long signed download URLs stay valid (default 15 minutes).
SIGNED_URL_TTL_MINUTES=15

# --- Frontend (Vite) ---------------------------------------------------------
# Base URL the React app uses for API calls. Empty = same origin (production).
VITE_API_BASE_URL=http://localhost:5001
